    title = {Evaluation of Metaverse Tools Based on Privacy Model Using Fuzzy MCDM Approach},
    author = {Husin, Nor Azura and Abdulsaeed, Ali A. and Muhsen, Yousif Raad and Zaidan, Ali Shakir and Alnoor, Alhamzah and Al-mawla, Zahraa Raad},
    year = {2023},
