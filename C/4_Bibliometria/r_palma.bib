@article{chudnovsky_innovation_2006,
	title = {Innovation and productivity in developing countries: {A} study of {Argentine} manufacturing firms’ behavior (1992–2001)},
	volume = {35},
	issn = {0048-7333},
	shorttitle = {Innovation and productivity in developing countries},
	url = {http://www.sciencedirect.com/science/article/pii/S0048733305002039},
	doi = {10.1016/j.respol.2005.10.002},
	abstract = {Following the methodology employed in studies for industrialized countries and using panel data from innovation surveys in Argentina with information for 1992–2001, this paper contributes to the nascent literature that analyzes the determinants of innovative inputs and outputs and their impacts on manufacturing firms’ productivity in developing countries. The econometric results show that in house R\&amp;D and technology acquisition expenditures have positive payoffs in terms of enhanced probability of introducing new products and/or processes to the market. In turn, innovators attain higher productivity levels than non-innovators. The results also show that large firms have a higher probability of engaging in innovation activities and of becoming innovators.},
	number = {2},
	urldate = {2013-05-13},
