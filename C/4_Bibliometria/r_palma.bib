@book{luchetti_memorias_2016,
	title = {Memorias del {Simposio} de {Ingeniería} de la {Producción}: {XVI} {SEPROSUL}},
	isbn = {978-987-46333-0-9},
	shorttitle = {Memorias del {Simposio} de {Ingeniería} de la {Producción}},
	abstract = {The Association of Universities Grupo Montevideo (AUGM) is a network of public, autonomous and self-governing universities of Argentina, Bolivia, Brazil, Chile, Paraguay and Uruguay which, because of their similarities, share their vocations, their public, their similarities in academic structures and equivalence of the levels of their services; characteristics that place them in a position to develop cooperation activities with certain prospects for viability. Born in August 1991 to respond to the challenges by running through university life in the world. A set of universities and university understood the need to work for excellence, quality, relevance and fulfill the tasks required of public higher education. It was consolidated in the course of the years sharing in solidarity, personal academic highest rating, material resources, facilities, equipment, laboratories, libraries, building an expanded common academic space, where obstacles are overcome and the possibilities of action multiply. AUGM is organized and Nuclei Disciplinary Academic Committees. The South American Symposium on Production Engineering (SEPROSUL) is the annual event of the Disciplinary Core of Mechanical Engineering and Production (NDIMP). The Faculty of Applied Sciences Industry is part of NDIMP and both are responsible for the organization of the XVI edition of the event. It is expected to SEPROSUL become an international forum for discussion and debate for all companies and professionals related to Production Engineering, the State at various levels and experts, researchers and teachers involved in the training of future professionals. Movement against the integration of South America, there is a need to strengthen the academic integration among the Southern Cone countries. Thus, the main objective SEPROSUL enable the exchange of experiences and the establishment of joint ventures for the social development of the country strategies, research and teaching in the area of Mechanical Engineering and Production in South America. The XVI SEPROSUL be held from 19 to 21 October this year and is particularly relevant as we celebrate 25 years of the AUGM.

RESUMEN. La Asociación de Universidades Grupo Montevideo (AUGM) es una Red de Universidades públicas, autónomas y autogobernadas de Argentina, Bolivia, Brasil, Chile, Paraguay y Uruguay que, en razón de sus semejanzas, comparten sus vocaciones, su carácter público, sus similitudes en las estructuras académicas y la equivalencia de los niveles de sus servicios; características que las sitúan en condiciones de desarrollar actividades de cooperación con perspectivas ciertas de viabilidad. Nace en agosto de 1991 para dar respuesta a los desafíos por los que atravesaba la vida universitaria en el mundo. Un conjunto de Universidades y universitarios, comprendieron la necesidad de trabajar por la excelencia, la calidad, la pertinencia y cumplir con los cometidos que la educación superior pública requería. Se consolidó en el devenir de los años compartiendo de manera solidaria, personal académico de máxima calificación, recursos materiales, instalaciones, equipamientos, laboratorios, Bibliotecas, construyendo un espacio académico común ampliado, donde los obstáculos son superados y se multiplican las posibilidades de acción. La AUGM está organizada en Comités Académicos y Núcleos Disciplinarios. El Simposio Sudamericano de Ingeniería de la Producción (SEPROSUL) es el evento anual del Núcleo Disciplinario de Ingeniería Mecánica y de la Producción (NDIMP). La Facultad de Ciencias Aplicadas a la Industria forma parte del NDIMP y ambos son los responsables de la organización de la edición XVI del evento. Se espera que el SEPROSUL se convierta en un foro internacional de discusión y debate para todas las empresas y los profesionales vinculados a la Ingeniería de la Producción, el Estado en sus diversos niveles y a los expertos, investigadores y docentes implicados en la formación de los futuros profesionales del área. Frente al movimiento de integración de América del Sur, existe la necesidad de fortalecer la integración académica entre los países del Cono Sur. Así, el SEPROSUL tiene como objetivo principal posibilitar el intercambio de experiencias y el establecimiento de estrategias conjuntas para el desarrollo social de los países, la investigación y la enseñanza en el área de Ingeniería Mecánica y de la Producción de América del Sur. El XVI SEPROSUL se realizará del 19 al 21 de octubre del corriente año y cobra particular relevancia ya que se festejan los 25 años de la AUGM.},
	author = {Luchetti, Federico and Verónica Kyanko, María and Ludemann, Vanesa and Arraiz, Gastón and Raquel Martín, Fanny and Maris de Lourdes Alcantú, Stella and Mabel Evangelista, Sara and Beatriz Guajardo, Adriana and Laura Díaz, María and De La Sierra, Yamila and Sandoval, Benjamín and Fonseca Albuquerque Cavalcanti Sigahi, Tiago and Fernandes Ferrarini, Cleyton and Borrás, Miguel and Saltorato, Patrícia and Roggiero, Augusto and Santa María, Julieta and Cecilia Guillén, M and Sánchez Varretti, Emanuel and Tucci, Víctor},
	month = oct,
	year = {2016},
	file = {Snapshot:/home/rpalma/Zotero/storage/QJUQXTIB/Memorias-del-Simposio-de-Ingenieria-de-la-Produccion-XVI-SEPROSUL.pdf:application/pdf}
}

